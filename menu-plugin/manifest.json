  },
  "barWidget": {
    "displayName": "Cyberpunk menu",
    "description": "Launches the Omarchy menu",
    "category": "Compositor",
    "allowMultiple": false
  },
  "omarchy": { "clonedFrom": "omarchy.menu" }
}
