{
  "schemaVersion": 1,
  "id": "lightqv.cyberpunk-menu",
  "name": "Cyberpunk menu",
  "version": "1.0.0",
  "author": "Omarchy, lightqv",
  "description": "Theme-scoped red and turquoise visual clone of the Omarchy command menu",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
