#!/usr/bin/env python3
"""Render palette-derived transparent artwork for Plymouth and SDDM."""

import argparse
import json
import tomllib
from pathlib import Path

from PIL import Image, ImageDraw, ImageFilter, ImageFont

ROOT = Path(__file__).resolve().parent.parent
BOOT = ROOT / "plymouth-theme"
GREETER = ROOT / "sddm-theme"
SOURCE = Path("/usr/share/omarchy/default/plymouth/logo.png")
FONT = Path("/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf")

# (x, y, width, height, shift) in fractions of the raster except for height
# and shift, which are source pixels. Each frame touches only a few glyphs.
LOGO_FAULTS = (
    ((.12, .34, .15, 7, 9), (.66, .67, .10, 5, -5), (.40, .48, .08, 4, 6)),
    ((.45, .54, .13, 5, -7), (.81, .39, .08, 4, 4)),
    ((.27, .73, .10, 6, -6), (.78, .30, .15, 8, 11), (.53, .38, .07, 4, 4), (.10, .57, .11, 5, -7)),
    ((.60, .58, .08, 4, 5), (.24, .42, .09, 4, -4)),
    ((.16, .49, .21, 10, -12), (.70, .73, .14, 5, 6), (.48, .29, .09, 5, 8)),
    ((.39, .33, .09, 5, 6), (.84, .54, .07, 4, -4), (.13, .70, .11, 5, 5)),
    ((.55, .71, .13, 6, -5), (.31, .45, .06, 4, 4)),
)
# Unequal brief holds at 50 FPS; the settled logo begins at tick 24.
LOGO_HOLDS = (3, 2, 4, 2, 4, 3, 6)


def text(image, xy, message, size, color):
    density = image.info.get("density", 1)
    ImageDraw.Draw(image).text((xy[0] * density, xy[1] * density), message,
                               font=ImageFont.truetype(str(FONT), size * density), fill=color)


def boot_art(width, height):
    image = Image.new("RGBA", (width * 2, height * 2))
    image.info["density"] = 2
    return image


def doubled(points):
    return [tuple(value * 2 for value in point) for point in points]


def fault_sparks(bounds):
    """Return short horizontal shards positioned around the visible wordmark."""
    left, top, right, bottom = bounds
    return (
        ((left - 34, top + 73, left + 8, top + 73), (left + 173, top - 23, left + 194, top - 23)),
        ((right - 14, top + 106, right + 33, top + 106), (right - 143, bottom + 20, right - 120, bottom + 20)),
        ((left + 203, top - 36, left + 232, top - 36), (left - 29, bottom - 82, left + 6, bottom - 82)),
        ((right - 279, bottom + 29, right - 255, bottom + 29), (right - 3, top + 63, right + 23, top + 63)),
        ((right - 7, bottom - 48, right + 29, bottom - 48), (left - 25, top + 39, left + 13, top + 39)),
        ((right - 222, bottom + 35, right - 196, bottom + 35), (right - 9, top + 136, right + 28, top + 136)),
        ((left + 333, top - 29, left + 359, top - 29), (left - 21, bottom - 58, left + 10, bottom - 58)),
    )


def render_images():
    colors = tomllib.loads((ROOT / "theme/colors.toml").read_text())
    layout = json.loads((ROOT / "theme/login-layout.json").read_text())
    red, cyan = colors["red"], colors["cyan"]
    source = Image.open(SOURCE).convert("RGBA")
    # Keep room for the bloom without wasting visible space below the letters.
    padding = 48
    mask = Image.new("L", (source.width + 2 * padding, source.height + 2 * padding))
    mask.paste(source.getchannel("A"), (padding, padding))
    # Dilate alpha for an edge that follows the letters, never their bounding box.
    edge = mask.filter(ImageFilter.MaxFilter(5))
    glow = edge.filter(ImageFilter.GaussianBlur(13))
    bloom = edge.filter(ImageFilter.GaussianBlur(27))
    logo = Image.new("RGBA", mask.size)
    highlight = colors["bright_cyan"]
    for silhouette, color, opacity in ((bloom, cyan, 0.27), (glow, cyan, 0.62),
                                       (edge, cyan, 0.85), (mask, cyan, 1),
                                       (mask.filter(ImageFilter.GaussianBlur(1)), highlight, 0.15)):
        layer = Image.new("RGBA", mask.size, color)
        layer.putalpha(silhouette.point(lambda value: round(value * opacity)))
        logo.alpha_composite(layer)

    art = {GREETER / "logo.png": logo, BOOT / "logo.png": logo}
    visible = mask.point(lambda alpha: 255 if alpha > 150 else 0).getbbox()
    # Sparse, detached shards escape the lettering by up to ~38 source pixels.
    # Keep each beat irregular and the 46px transparent margin unclipped.
    sparks = fault_sparks(visible)
    for index, fragments in enumerate(LOGO_FAULTS):
        variant = logo.copy()
        for part, (x, y, width, height, shift) in enumerate(fragments):
            left = round(logo.width * x)
            top = round(logo.height * y)
            right = min(logo.width, left + round(logo.width * width))
            band = logo.crop((left, top, right, top + height))
            ImageDraw.Draw(variant).rectangle((left, top, right - 1, top + height - 1), fill=(0, 0, 0, 0))
            variant.alpha_composite(band, (left + shift, top))
            # Short electrical traces, never a rule across the whole wordmark.
            start = left + max(0, shift)
            end = min(right, start + (right - left) // 3)
            ImageDraw.Draw(variant).line((start, top, end, top),
                                        fill=colors["bright_cyan"] if part % 2 == 0 else red, width=1)
        for x1, y1, x2, y2 in sparks[index]:
            ImageDraw.Draw(variant).line((x1, y1, x2, y2), fill=cyan, width=2)
            ImageDraw.Draw(variant).line((x2 + 3, y2, x2 + 9, y2), fill=red, width=1)
        art[BOOT / f"logo-fault-{index}.png"] = variant
        art[GREETER / f"logo-fault-{index}.png"] = variant
    frame_width, frame_height = 1920, 1080
    def rgb(value):
        return tuple(bytes.fromhex(value[1:]))

    def between(start, end, amount):
        return tuple(round(a + (b - a) * amount) for a, b in zip(start, end))

    burgundy = tuple(max(0, value - delta) for value, delta in zip(rgb(red), (204, 30, 40)))
    vertical = Image.new("RGBA", (1, frame_height))
    for y in range(frame_height):
        ratio = y / (frame_height - 1)
        if ratio < 0.49:
            color = between(burgundy, rgb(colors["background"]), ratio / 0.49)
        else:
            color = between(rgb(colors["background"]), rgb(colors["darker_background"]), (ratio - 0.49) / 0.51)
        vertical.putpixel((0, y), (*color, 255))
    frame = vertical.resize((frame_width, frame_height))
    horizontal = Image.new("RGBA", (frame_width, 1))
    for x in range(frame_width):
        ratio = x / (frame_width - 1)
        if ratio < 0.38:
            value = between((48, 26, 35, 85), (27, 17, 24, 0), ratio / 0.38)
        else:
            value = between((27, 17, 24, 0), (7, 8, 13, 136), (ratio - 0.38) / 0.62)
        horizontal.putpixel((x, 0), value)
    frame.alpha_composite(horizontal.resize((frame_width, frame_height)))
    background = frame
    frame = Image.new("RGBA", background.size)
    draw = ImageDraw.Draw(frame)
    inset = int(frame_width * 0.05)
    draw.line((inset, 97, frame_width - inset, 97), fill=(*bytes.fromhex(red[1:]), 211), width=2)
    draw.line((inset, 929, frame_width - inset, 929), fill=(*bytes.fromhex(red[1:]), 165))
    draw.rectangle((inset, 99, inset + 140, 101), fill=red)
    draw.line((25, 32, 25, 1015), fill=(*bytes.fromhex(red[1:]), 65))
    draw.line((1888, 38, 1888, 1010), fill=(*bytes.fromhex(red[1:]), 65))
    for x, chars in ((29, ("01", "│", "∟", "110", "⋮", "03", "░", "│", "07", "··", "01", "∟", "101", "⋮", "02", "│", "⌁", "11", "│", "00", "⋮", "∟", "07", "│", "10")),
                     (1876, ("10", "⋮", "01", "┐", "001", "░", "│", "11", "⋮", "03", "│", "101", "┐", "00", "│", "01", "⋮", "07", "░", "│", "10", "┐", "11", "│"))):
        for index, char in enumerate(chars):
            text(frame, (x, 32 + index * 27), char, 8, (*bytes.fromhex(red[1:]), 130 if index % 5 else 185))
    text(frame, (106, 49), "// OMARCHY     /     CYBERPUNK", 13, cyan)
    text(frame, (106, 993), "ENTER  AUTHENTICATE     /     DISK UNLOCK", 8, colors["dark_foreground"])
    art[BOOT / "frame.png"] = Image.alpha_composite(background, frame)
    prompt = boot_art(381, 54)
    draw = ImageDraw.Draw(prompt)
    # The sudo field's simple 1px border, 4px left accent and the same
    # translucent red fill (22/255) as its submit button.
    draw.rectangle((0, 0, 761, 107), fill=(*bytes.fromhex(red[1:]), 22), outline=red, width=2)
    draw.rectangle((0, 0, 7, 107), fill=red)
    text(prompt, (24, 14), ">", 19, red)
    art[BOOT / "entry.png"] = prompt
    scanner = boot_art(layout["promptWidth"], layout["fieldY"])
    draw = ImageDraw.Draw(scanner)
    draw.line((0, 0, 36, 0), fill=red, width=4)
    draw.line((0, 0, 0, 28), fill=red, width=4)
    draw.line((50, 0, (layout["promptWidth"] - 25) * 2, 0), fill=(*bytes.fromhex(red[1:]), 170), width=2)
    draw.line(((layout["promptWidth"] - 1) * 2, 0, (layout["promptWidth"] - 1) * 2, 28), fill=red, width=4)
    text(scanner, (25, 39), "// AUTHENTICATION SEQUENCE", 13, red)
    text(scanner, (25, 78), "USER", 12, colors["dark_foreground"])
    text(scanner, (layout["promptWidth"] - 96, 78), "LOCAL USER", 12, colors["foreground"])
    text(scanner, (24, 97), "ENTER PASSWORD", 11, colors["dark_foreground"])
    art[BOOT / "scanner.png"] = scanner
    placeholder = boot_art(381, 54)
    text(placeholder, (56, 15), "ENTER PASSWORD", 18, colors["dark_foreground"])
    art[BOOT / "placeholder.png"] = placeholder

    action = boot_art(381, 48)
    draw = ImageDraw.Draw(action)
    draw.polygon(doubled([(22, 0), (380, 0), (380, 39), (372, 47), (0, 47), (0, 22)]),
                 fill=(*bytes.fromhex(red[1:]), 22), outline=red, width=2)
    text(action, (158, 14), "LOG IN", 14, red)
    art[BOOT / "action.png"] = action
    hint = boot_art(381, 18)
    text(hint, (0, 0), "ENTER CONFIRM  /  DISK UNLOCK", 11, colors["dark_foreground"])
    art[BOOT / "hint.png"] = hint

    track = boot_art(381, 18)
    draw = ImageDraw.Draw(track)
    draw.rectangle((0, 16, 761, 21), fill=(*bytes.fromhex(cyan[1:]), 68))
    art[BOOT / "progress_box.png"] = track
    fill = boot_art(381, 18)
    draw = ImageDraw.Draw(fill)
    for y, alpha in ((2, 12), (3, 24), (4, 43), (5, 75), (6, 120), (7, 180), (8, 255), (9, 255), (10, 180), (11, 120), (12, 75), (13, 43), (14, 24), (15, 12)):
        draw.rectangle((0, y * 2, 761, y * 2 + 1), fill=(*bytes.fromhex(cyan[1:]), alpha))
    art[BOOT / "progress_bar.png"] = fill

    bullet = boot_art(16, 30)
    ImageDraw.Draw(bullet).polygon(doubled([(1, 0), (14, 0), (14, 25), (9, 29), (1, 29)]),
                                    fill=(255, 67, 91, 50), outline="#ff435b", width=3)
    art[BOOT / "bullet.png"] = bullet
    caret = boot_art(2, 25)
    ImageDraw.Draw(caret).rectangle((0, 0, 3, 49), fill=colors["bright_red"])
    art[BOOT / "caret.png"] = caret
    return art


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--write", action="store_true")
    mode.add_argument("--check", action="store_true")
    args = parser.parse_args()
    layout = json.loads((ROOT / "theme/login-layout.json").read_text())
    generated = "// Generated by scripts/render-login-art from theme/login-layout.json.\n"
    generated += "".join(f"var {key} = {value};\n" for key, value in layout.items())
    layout_paths = (ROOT / "lock-plugin/LoginLayout.js", GREETER / "layout.js")
    if args.check:
        # Render to a temporary directory? Compare pixel contents against the
        # deterministic output by saving each image to an in-memory PNG.
        from io import BytesIO

        for path, image in render_images().items():
            stream = BytesIO()
            image.save(stream, format="PNG")
            if not path.is_file() or path.read_bytes() != stream.getvalue():
                parser.error(f"stale login art: {path}")
        for path in layout_paths:
            if not path.is_file() or path.read_text() != generated:
                parser.error(f"stale login layout: {path}")
    else:
        for path, image in render_images().items():
            image.save(path)
        for path in layout_paths:
            path.write_text(generated)


if __name__ == "__main__":
    main()
