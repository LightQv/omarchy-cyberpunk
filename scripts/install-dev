#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

[[ $# == 0 ]] || die "usage: scripts/install-dev"
umask 077
lifecycle_lock
"$PROJECT/scripts/render-palette" --check || die "render Cyberpunk palette before installation"
"$PROJECT/scripts/build-lock" --check || die "Cyberpunk lock differs from the pinned Omarchy release"
omarchy plugin validate "$PLUGIN_SOURCE"
omarchy plugin validate "$POLKIT_SOURCE"
omarchy plugin validate "$NOTIFY_SOURCE"
omarchy plugin validate "$OSD_SOURCE"
omarchy plugin validate "$LOCK_SOURCE"
[[ $(jq -r .id "$PLUGIN_SOURCE/manifest.json") == "$PLUGIN_ID" ]] || die "plugin id mismatch"
[[ $(jq -r .id "$POLKIT_SOURCE/manifest.json") == "$POLKIT_ID" ]] || die "Polkit plugin id mismatch"
[[ $(jq -r .id "$NOTIFY_SOURCE/manifest.json") == "$NOTIFY_ID" ]] || die "notifications plugin id mismatch"
[[ $(jq -r .id "$OSD_SOURCE/manifest.json") == "$OSD_ID" ]] || die "OSD plugin id mismatch"
[[ $(jq -r .id "$LOCK_SOURCE/manifest.json") == "$LOCK_ID" ]] || die "lock plugin id mismatch"
[[ -x $PROJECT/askpass/cyberpunk-askpass ]] || die "graphical askpass unavailable"
"$PROJECT/scripts/manage-bashrc.py" absent
[[ -f $THEME_SOURCE/colors.toml ]] || die "theme colors missing"
for number in {01..13}; do
  [[ -f $THEME_SOURCE/backgrounds/$number.png ]] || die "theme wallpaper missing: $number.png"
done

for path in "$THEME_LINK" "$PLUGIN_LINK" "$POLKIT_LINK" "$NOTIFY_LINK" "$OSD_LINK" "$LOCK_LINK" "$HOOK_LINK" "$BOOT_LINK" "$CLI_LINK"; do
  unoccupied "$path" || die "path already occupied: $path"
done
[[ $(current_theme) != cyberpunk ]] || die "Cyberpunk already selected before install"
menu_enabled omarchy.menu || die "stock menu not enabled"
menu_enabled omarchy.polkit || die "stock Polkit agent not enabled"
menu_enabled omarchy.notifications || die "stock notifications not enabled"
menu_enabled omarchy.osd || die "stock OSD not enabled"
menu_enabled omarchy.lock || die "stock lock not enabled"
lock_unlocked || die "install only while the stock lock is ready and unlocked"
jq -e 'any(.bar.layout[]?[]?; (if type == "object" then .id else . end) == "omarchy.menu")' "$(shell_config)" >/dev/null || die "stock menu button missing; refusing to alter bar layout"
! clone_referenced || die "Cyberpunk clone already referenced in shell.json"
! polkit_referenced || die "Cyberpunk Polkit clone already referenced in shell.json"
! notify_referenced || die "Cyberpunk notifications clone already referenced in shell.json"
! osd_referenced || die "Cyberpunk OSD clone already referenced in shell.json"
! lock_referenced || die "Cyberpunk lock clone already referenced in shell.json"
omarchy plugin list --json | jq -e '[.[] | select(.clonedFrom == "omarchy.menu")] | length == 0' >/dev/null || die "another menu clone is installed; resolve conflict first"
omarchy plugin list --json | jq -e '[.[] | select(.clonedFrom == "omarchy.polkit")] | length == 0' >/dev/null || die "another Polkit clone is installed; resolve conflict first"
omarchy plugin list --json | jq -e '[.[] | select(.clonedFrom == "omarchy.notifications")] | length == 0' >/dev/null || die "another notifications clone is installed; resolve conflict first"
omarchy plugin list --json | jq -e '[.[] | select(.clonedFrom == "omarchy.osd")] | length == 0' >/dev/null || die "another OSD clone is installed; resolve conflict first"
omarchy plugin list --json | jq -e '[.[] | select(.clonedFrom == "omarchy.lock")] | length == 0' >/dev/null || die "another lock clone is installed; resolve conflict first"

previous=$(current_theme)
[[ -d /usr/share/omarchy/themes/$previous || -d $HOME/.config/omarchy/themes/$previous ]] || die "previous theme unavailable"
python -B "$PROJECT/scripts/backup-baseline.py"
python -B "$PROJECT/scripts/preferences.py" init
mkdir -p "$STATE_DIR"
if unoccupied "$SAFE_MODE"; then
  printf 'lock acceptance pending\n' >"$SAFE_MODE"
fi
printf '%s\n' "$previous" >"$STATE_DIR/previous-theme"

rollback() {
  status=$?
  trap - EXIT
  if (( status != 0 )); then
    printf 'Cyberpunk: install failed; restoring %s.\n' "$previous" >&2
    flock -u 7
    "$PROJECT/scripts/uninstall-dev" || printf 'Cyberpunk: rollback incomplete; unlock if necessary, then rerun scripts/uninstall-dev.\n' >&2
  fi
  exit "$status"
}
trap rollback EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

install_cli
mkdir -p "$(dirname "$THEME_LINK")" "$(dirname "$PLUGIN_LINK")" "$(dirname "$HOOK_LINK")" "$(dirname "$BOOT_LINK")"
ln -s "$THEME_SOURCE" "$THEME_LINK"
ln -s "$PLUGIN_SOURCE" "$PLUGIN_LINK"
ln -s "$POLKIT_SOURCE" "$POLKIT_LINK"
ln -s "$NOTIFY_SOURCE" "$NOTIFY_LINK"
ln -s "$OSD_SOURCE" "$OSD_LINK"
ln -s "$LOCK_SOURCE" "$LOCK_LINK"
omarchy-shell shell rescanPlugins >/dev/null
# Native rescan launches an asynchronous registry scan. Do not treat its IPC
# return as completed discovery, or advance while any clone is active/missing.
ids=$(jq -cn --args '$ARGS.positional' "$PLUGIN_ID" "$POLKIT_ID" "$NOTIFY_ID" "$OSD_ID" "$LOCK_ID")
discovered=false
for (( attempt=0; attempt<50; attempt++ )); do
  if plugins=$(timeout 2 omarchy plugin list --json) &&
    jq -e --argjson ids "$ids" '. as $plugins | all($ids[]; . as $id | any($plugins[]; .id == $id and .enabled == false))' <<<"$plugins" >/dev/null; then
    discovered=true
    break
  fi
  sleep 0.2
done
[[ $discovered == true ]] || die "clones were not discovered disabled; native services retained for recovery"
"$PROJECT/scripts/manage-bashrc.py" install
ln -s "$HOOK_SOURCE" "$HOOK_LINK"
ln -s "$BOOT_SOURCE" "$BOOT_LINK"
if [[ ${CYBERPUNK_RELEASE_STAGING:-} != 1 ]]; then
omarchy theme set cyberpunk
[[ $(current_theme) == cyberpunk ]] || die "theme changed during installation"
omarchy theme bg set "$HOME/.local/state/omarchy/current/theme/backgrounds/01.png"
"$PROJECT/scripts/verify" --check
[[ $(current_theme) == cyberpunk ]] || die "theme changed during final verification"
fi
trap - EXIT
printf 'Cyberpunk: installed. Run cyberpunk status; enable components with cyberpunk enable <component|all>.\n'
