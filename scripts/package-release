#!/usr/bin/env python3
"""Build a deterministic runtime-only release archive with a complete file manifest."""

import gzip
import hashlib
import io
import json
from pathlib import Path
import re
import subprocess
import sys
import tarfile

ROOT = Path(__file__).resolve().parent.parent
RUNTIME_SCRIPTS = {
    "common.sh", "cyberpunk", "preferences.py", "verify", "install-dev", "uninstall-dev",
    "backup-baseline.py", "manage-bashrc.py", "interactive-sudo.sh", "render-palette", "build-lock",
    "queue-lock-transition", "wait-unlocked", "release.py",
}
DIRECTORIES = {"theme", "askpass", "hooks", "menu-plugin", "polkit-plugin",
               "notifications-plugin", "osd-plugin", "lock-plugin"}


def main():
    version, destination = sys.argv[1:]
    if not re.fullmatch(r"v\d+\.\d+\.\d+", version):
        raise ValueError("Use a vX.Y.Z release version")
    output = Path(destination).resolve()
    if not output.is_dir():
        raise ValueError("Release output directory must already exist")
    names = subprocess.check_output(["git", "ls-files", "-z"], cwd=ROOT).decode().split("\0")
    names += ["install", "install.sh", "scripts/release.py"]
    selected = sorted({name for name in names if name and (
        name.split("/")[0] in DIRECTORIES or name in ("LICENSE", "THIRD_PARTY.md", "install", "install.sh")
        or name.startswith("scripts/") and name.removeprefix("scripts/") in RUNTIME_SCRIPTS)})
    files = {}
    blobs = {}
    for name in selected:
        path = ROOT / name
        if path.is_symlink() or not path.is_file():
            raise ValueError(f"Release source is not a regular file: {name}")
        mode = 0o755 if path.stat().st_mode & 0o111 or name in ("install", "scripts/release.py") else 0o644
        blobs[name] = path.read_bytes()
        files[name] = {"sha256": hashlib.sha256(blobs[name]).hexdigest(), "mode": mode}
    blobs["release.json"] = (json.dumps({"version": version, "omarchy": "4.0.4-1", "files": files}, indent=2) + "\n").encode()
    name = f"omarchy-cyberpunk-{version}"
    archive = output / (name + ".tar.gz")
    with archive.open("wb") as target, gzip.GzipFile(filename="", mode="wb", fileobj=target, mtime=0) as compressed:
        with tarfile.open(fileobj=compressed, mode="w") as bundle:
            for relative, content in sorted(blobs.items()):
                member = tarfile.TarInfo(name + "/" + relative)
                member.size = len(content)
                member.mode = files.get(relative, {}).get("mode", 0o644)
                bundle.addfile(member, io.BytesIO(content))
    (output / "SHA256SUMS").write_text(hashlib.sha256(archive.read_bytes()).hexdigest() + "  " + archive.name + "\n")
    print(f"Packaged {len(files)} runtime files: {archive}")


if __name__ == "__main__":
    main()
