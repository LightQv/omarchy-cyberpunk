#!/usr/bin/env python3
"""Preview lock, sudo and Polkit without invoking authentication services."""

import os
import argparse
import hashlib
import json
import sys
import tempfile
import time
from pathlib import Path

os.environ["QT_QPA_PLATFORM"] = "offscreen"
os.environ["QT_SCALE_FACTOR"] = "1"

from PIL import Image, ImageFilter, ImageOps
from PySide6.QtCore import QUrl
from PySide6.QtGui import QImage, QPainter
from PySide6.QtQuick import QQuickView
from PySide6.QtWidgets import QApplication

from preview_video import encode_video

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "preview"
SIZE = (1920, 1080)
FPS = 50
INPUTS = ("scripts/preview-final", "scripts/preview_video.py", "lock-plugin/ReviewScene.qml",
          "lock-plugin/LockHud.qml", "lock-plugin/AuthLayout.js", "lock-plugin/SignalFault.qml",
          "lock-plugin/SignalRhythm.qml", "lock-plugin/PreviewPalette.js",
          "askpass/askpass.py", "askpass/FaultBackdrop.qml")


def qt_image(image):
    if image.isNull() or (image.width(), image.height()) != SIZE:
        raise RuntimeError("Offline capture did not produce a 1920x1080 frame")
    # Avoid ImageQt's PNG encode/decode round-trip on every video frame.
    pixels = image.convertToFormat(QImage.Format_RGB888)
    return Image.frombytes("RGB", SIZE, pixels.bits(), "raw", "RGB", pixels.bytesPerLine())


def dialog_phase(seconds):
    # Reproducible sample of the live slow/fast/medium sequence bag, with pauses.
    duration = (1.4, .85, 1.1)
    pauses = (.45, .7, .35)
    seconds %= sum(duration) + sum(pauses)
    for span, pause in zip(duration, pauses):
        if seconds < span:
            return seconds / span
        seconds -= span
        if seconds < pause:
            return 1
        seconds -= pause
    return 1


def render_scene(app, polkit, blurred, sharp):
    view = QQuickView()
    view.setResizeMode(QQuickView.SizeRootObjectToView)
    view.resize(*SIZE)
    view.setSource(QUrl.fromLocalFile(str(ROOT / "lock-plugin/ReviewScene.qml")))
    if view.status() != QQuickView.Ready:
        raise RuntimeError("Could not load the offline lock/Polkit review scene")
    scene = view.rootObject()
    scene.setProperty("polkitMode", polkit)
    scene.setProperty("reviewUserName", "LOCAL USER")
    scene.setProperty("blurredSource", QUrl.fromLocalFile(str(blurred)))
    scene.setProperty("sharpSource", QUrl.fromLocalFile(str(sharp)))
    view.show()
    for _ in range(10):
        app.processEvents()
        view.grabWindow()

    def frame(phase):
        scene.setProperty("phase", phase)
        app.processEvents()
        return qt_image(view.grabWindow())

    name = "polkit" if polkit else "lock"
    still = frame(1)
    still.save(OUTPUT / f"{name}.png")

    def frames():
        for tick in range(350 if polkit else 90):
            yield frame(dialog_phase(tick / FPS) if polkit else min(1.0, tick / 38))

    try:
        encode_video(frames(), OUTPUT / f"{name}.mp4", FPS)
    finally:
        view.close()


def render_sudo(app, sharp):
    sys.path.insert(0, str(ROOT / "askpass"))
    from askpass import Askpass

    class OfflineAskpass(Askpass):
        def accept(self):
            raise RuntimeError("Offline review cannot submit a password")

        def reject(self):
            raise RuntimeError("Offline review cannot cancel an auth request")

    widget = OfflineAskpass("Authorization is required")
    widget.resize(*SIZE)
    widget.scene = QImage(str(sharp))
    widget.install_fault_backdrop(widget.scene)
    if widget.scene.isNull():
        raise RuntimeError("Offline sudo background failed to load")
    widget.variant = 0
    widget.show()
    app.processEvents()
    widget.pulse.stop()

    def frame(phase):
        if phase < 1:
            widget.pulse.start()
            widget.started_at = time.monotonic() - phase * widget.fault_duration
        else:
            widget.pulse.stop()
        widget.sync_fault_frame()
        app.processEvents()
        widget.repaint()
        image = widget.grab().toImage()
        # Offscreen QWidget grabs composite the opaque QQuickWidget after the
        # parent's paint event. Restore its actual header painter above that FBO.
        painter = QPainter(image)
        widget._paint_header(painter)
        painter.end()
        return qt_image(image)

    still = frame(1)
    still.save(OUTPUT / "sudo.png")

    def frames():
        for tick in range(350):
            yield frame(dialog_phase(tick / FPS))

    try:
        encode_video(frames(), OUTPUT / "sudo.mp4", FPS)
    finally:
        widget.pulse.stop()
        widget.password.clearFocus()
        widget.hide()
        app.processEvents()
        widget.close()
        widget.deleteLater()
        app.processEvents()


def main():
    global OUTPUT
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("lock", "sudo", "polkit"):
        parser.add_argument(f"--{name}-wallpaper", default="01.png", metavar="FILE.png")
    args = parser.parse_args()
    wallpapers = {}
    for name in ("lock", "sudo", "polkit"):
        path = (ROOT / "theme/backgrounds" / getattr(args, name + "_wallpaper")).resolve()
        if path.parent != (ROOT / "theme/backgrounds").resolve() or not path.is_file():
            parser.error(f"{name} wallpaper must be a file in theme/backgrounds")
        wallpapers[name] = path
    OUTPUT.mkdir(parents=True, exist_ok=True)
    destination = OUTPUT
    os.environ["USER"] = "LOCAL USER"
    with tempfile.TemporaryDirectory(prefix=".render-", dir=destination) as directory:
        OUTPUT = Path(directory)
        app = QApplication([])
        for name, wallpaper in wallpapers.items():
            sharp = OUTPUT / "sharp.png"
            blurred = OUTPUT / "blurred.png"
            with Image.open(wallpaper) as image:
                original = ImageOps.fit(image.convert("RGB"), SIZE, method=Image.Resampling.LANCZOS)
            original.save(sharp)
            original.filter(ImageFilter.GaussianBlur(9)).save(blurred)
            if name == "sudo":
                render_sudo(app, sharp)
            else:
                render_scene(app, name == "polkit", blurred, sharp)
        manifest = {
            "version": 1, "kind": "offline authentication appearance; no PAM or Polkit registration",
            "wallpapers": {name: {"file": str(path.relative_to(ROOT)),
                                  "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
                           for name, path in wallpapers.items()},
            "inputs": {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest() for name in INPUTS},
        }
        for name in wallpapers:
            for extension in ("png", "mp4"):
                (OUTPUT / f"{name}.{extension}").replace(destination / f"{name}.{extension}")
        (destination / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    OUTPUT = destination


if __name__ == "__main__":
    main()
