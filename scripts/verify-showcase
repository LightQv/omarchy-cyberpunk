#!/usr/bin/env python3
"""Check public showcase integrity, current inputs, media decoding and README links."""

import hashlib
import json
from pathlib import Path
import re
import subprocess

from PIL import Image

ROOT = Path(__file__).resolve().parent.parent
MEDIA = ROOT / "docs/media"


def main():
    manifest = json.loads((MEDIA / "manifest.json").read_text())
    files = manifest["files"]
    actual = {path.name for path in MEDIA.iterdir() if path.suffix in (".png", ".gif", ".mp4")}
    if actual != set(files): raise ValueError("Showcase file list differs from manifest")
    for name, digest in files.items():
        path = MEDIA / name
        if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
            raise ValueError(f"Showcase hash mismatch: {name}")
        if path.suffix in (".png", ".gif"):
            with Image.open(path) as image:
                image.load()
                if image.width < 400 or image.height < 250:
                    raise ValueError(f"Unexpected showcase dimensions: {name}")
                if path.suffix == ".gif" and getattr(image, "n_frames", 1) < 2:
                    raise ValueError(f"Showcase GIF is not animated: {name}")
        else:
            metadata = json.loads(subprocess.check_output(["ffprobe", "-v", "error", "-show_entries",
                "stream=width,height,avg_frame_rate:format=duration", "-of", "json", str(path)]))
            video = metadata["streams"][0]
            expected_fps = "20/1" if name == "menu.mp4" else "50/1"
            if (video["width"], video["height"], video["avg_frame_rate"]) != (1920, 1080, expected_fps):
                raise ValueError(f"Unexpected video format: {name}")
            if float(metadata["format"]["duration"]) < 1.4:
                raise ValueError(f"Incomplete clip: {name}")
    live = manifest.get("liveDesktop")
    groups = [manifest["desktop"], manifest["auth"]]
    if live:
        groups.append(live)
        if "desktop.png" not in files:
            raise ValueError("Live desktop capture is missing")
        if hashlib.sha256((ROOT / "theme/backgrounds" / live["wallpaper"]).read_bytes()).hexdigest() != live["wallpaperSha256"]:
            raise ValueError("Live desktop wallpaper changed")
    for group in groups:
        for name, digest in group["inputs"].items():
            if hashlib.sha256((ROOT / name).read_bytes()).hexdigest() != digest:
                raise ValueError(f"Showcase input changed: {name}")
    for name, digest in manifest["desktop"]["wallpaperHashes"].items():
        if hashlib.sha256((ROOT / "theme/backgrounds" / name).read_bytes()).hexdigest() != digest:
            raise ValueError(f"Desktop wallpaper changed: {name}")
    for entry in manifest["auth"]["wallpapers"].values():
        if hashlib.sha256((ROOT / entry["file"]).read_bytes()).hexdigest() != entry["sha256"]:
            raise ValueError("Auth wallpaper changed")
    for document in (ROOT / "README.md", MEDIA / "README.md"):
        text = document.read_text()
        links = re.findall(r'(?:src|href)="([^"]+)"', text) + re.findall(r'\]\(([^)]+)\)', text)
        for link in links:
            if "://" in link or link.startswith("#"): continue
            if not (document.parent / link.split("#")[0]).exists():
                raise ValueError(f"Broken local link in {document.name}: {link}")
    print(f"{len(files)} current showcase assets decoded/verified; local README links resolve.")


if __name__ == "__main__":
    main()
