#!/usr/bin/env python3
"""Validate native-size offline review assets and visible one-shot motion."""

import json
import subprocess
from pathlib import Path

from PIL import Image, ImageChops, ImageStat

ROOT = Path(__file__).resolve().parent.parent / "preview"
NAMES = ("boot", "login", "lock", "sudo", "polkit")
SIZE = (1920, 1080)


def image_at(path, seconds):
    pixels = subprocess.check_output([
        "ffmpeg", "-v", "error", "-ss", str(seconds), "-i", str(path),
        "-frames:v", "1", "-f", "rawvideo", "-pix_fmt", "rgb24", "pipe:1",
    ])
    return Image.frombytes("RGB", SIZE, pixels).crop((30, 100, 1830, 1000))


def difference(first, second):
    return sum(ImageStat.Stat(ImageChops.difference(first, second)).mean)


def main():
    expected = {f"{name}.{extension}" for name in NAMES for extension in ("png", "mp4")}
    actual = {path.name for path in ROOT.iterdir()}
    if actual != expected:
        raise RuntimeError(f"Unexpected review files: missing {sorted(expected - actual)}, "
                           f"extra {sorted(actual - expected)}")
    for name in NAMES:
        still = ROOT / f"{name}.png"
        video = ROOT / f"{name}.mp4"
        with Image.open(still) as image:
            if image.size != SIZE or image.mode != "RGB":
                raise RuntimeError(f"{still} is not a clean full-HD RGB still")
        metadata = json.loads(subprocess.check_output([
            "ffprobe", "-v", "error", "-show_entries",
            "stream=width,height,avg_frame_rate:format=duration", "-of", "json", str(video),
        ]))
        stream = metadata["streams"][0]
        if (stream["width"], stream["height"]) != SIZE or stream["avg_frame_rate"] != "50/1":
            raise RuntimeError(f"{video} is not a 1920x1080 50 FPS clip")
        duration = float(metadata["format"]["duration"])
        if not 1.4 <= duration <= 3.0:
            raise RuntimeError(f"{video} has unexpected duration {duration:.2f}s")
        moving = difference(image_at(video, 0.12), image_at(video, 0.34))
        resting = difference(image_at(video, 1.10), image_at(video, 1.40))
        if moving < 0.01 or resting > max(0.15, moving * 0.10):
            raise RuntimeError(f"{video}: motion {moving:.3f}, settled {resting:.3f}")
        print(f"{name}: {SIZE[0]}x{SIZE[1]}, 50 FPS, {duration:.2f}s, "
              f"motion {moving:.3f}, settled {resting:.3f}")


if __name__ == "__main__":
    main()
