#!/usr/bin/env bash
# The greeter reads only this non-secret cosmetic selection on its next start.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

[[ $# == 1 ]] || die "usage: scripts/sddm-marker {sync|stock|status}"
case $1 in sync|stock|status) ;; *) die "unknown marker action" ;; esac

marker=/var/lib/omarchy-cyberpunk/selected-theme
if [[ ! -d ${marker%/*} || -L ${marker%/*} || ! -f $marker || -L $marker || $(stat -c %u "$marker") != "$EUID" ]]; then
  die "SDDM marker is missing or not owned by this user"
fi

if [[ $1 == status ]]; then
  value=$(<"$marker")
  if [[ $value == $'[Theme]\nselected=cyberpunk' ]]; then
    printf 'cyberpunk\n'
  else
    printf 'omarchy\n'
  fi
  exit 0
fi

selection=omarchy
if [[ $1 == sync && $(current_theme) == cyberpunk && ! -e $SAFE_MODE ]]; then selection=cyberpunk; fi
printf '[Theme]\nselected=%s\n' "$selection" >"$marker"
[[ $(<"$marker") == "$(printf '[Theme]\nselected=%s' "$selection")" ]] || die "SDDM marker write failed"
