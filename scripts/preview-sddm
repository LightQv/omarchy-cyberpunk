#!/usr/bin/env python3
"""Render SDDM source with dummy models; never send or request credentials."""

import argparse
import os
import time
from pathlib import Path

os.environ["QT_QPA_PLATFORM"] = "offscreen"

from PySide6.QtCore import QAbstractListModel, QModelIndex, QObject, Property, Qt, QThread, QUrl, Signal, Slot
from PySide6.QtGui import QGuiApplication
from PySide6.QtQuick import QQuickView
from PIL import Image, ImageDraw
from preview_video import encode_previews

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / ".state/diagnostic-previews"


class Sessions(QAbstractListModel):
    @Property(int, constant=True)
    def lastIndex(self):
        return 0

    def rowCount(self, parent=QModelIndex()):
        return 1

    def data(self, index, role=Qt.DisplayRole):
        return "DEFAULT SESSION" if index.isValid() and role == Qt.DisplayRole else None


class Users(QObject):
    @Property(str, constant=True)
    def lastUser(self):
        return "LOCAL USER"


class Auth(QObject):
    loginFailed = Signal()
    loginSucceeded = Signal()

    @Slot(str, str, int)
    def login(self, _user, _password, _session):
        raise RuntimeError("Offline preview must never authenticate")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mp4", action="store_true", help="encode full-size and close-up offline review videos")
    parser.add_argument("--output-dir", type=Path, default=OUT,
                        help="directory for diagnostic artifacts (default: ignored state)")
    args = parser.parse_args()
    output = args.output_dir
    output.mkdir(parents=True, exist_ok=True)
    app = QGuiApplication([])
    view = QQuickView()
    view.rootContext().setContextProperty("sessionModel", Sessions(view))
    view.rootContext().setContextProperty("userModel", Users(view))
    view.rootContext().setContextProperty("sddm", Auth(view))
    view.setResizeMode(QQuickView.SizeRootObjectToView)
    view.resize(1920, 1080)
    view.setSource(QUrl.fromLocalFile(str(ROOT / "sddm-theme/Main.qml")))
    if view.status() != QQuickView.Ready:
        raise RuntimeError("Could not load the SDDM source view")
    view.show()
    entrance_frames = []
    timed_frames = []
    # Let Qt negotiate the offscreen window size before recording the entrance.
    for _ in range(3):
        app.processEvents()
    started = time.monotonic()
    for _ in range(28 if args.mp4 else 15):
        app.processEvents()
        screenshot = view.grabWindow()
        if not screenshot.isNull() and screenshot.width() == 1920 and screenshot.height() == 1080:
            full_frame = Image.fromqimage(screenshot).convert("RGB")
            entrance_frames.append(full_frame.resize((960, 540), Image.Resampling.LANCZOS))
            if args.mp4:
                timed_frames.append((time.monotonic() - started, full_frame))
        QThread.msleep(15 if args.mp4 else 50)
    if len(entrance_frames) < 10:
        raise RuntimeError("Unable to record SDDM entrance")
    entrance_frames[0].save(output / "login-appearance.webp", save_all=True,
                            append_images=entrance_frames[1:], duration=50, loop=0, quality=85)
    image = view.grabWindow()
    if image.isNull():
        raise RuntimeError("Offscreen SDDM capture failed")
    image.save(str(output / "login-current.png"))
    if args.mp4:
        timed_frames.append((time.monotonic() - started, Image.fromqimage(image).convert("RGB")))

        def video_frames():
            end = max(1.5, timed_frames[-1][0] + 1.0)
            index = 0
            for tick in range(round(end * 50)):
                moment = tick / 50
                while index + 1 < len(timed_frames) and timed_frames[index + 1][0] <= moment:
                    index += 1
                yield timed_frames[index][1]

        encode_previews(video_frames(), output / "login-appearance.mp4",
                        output / "login-logo.mp4")

    input_field = view.rootObject().findChild(QObject, "passwordInput")
    if input_field is None:
        raise RuntimeError("SDDM preview password input missing")
    input_field.setProperty("text", "preview")
    for _ in range(10):
        app.processEvents()
        QThread.msleep(50)
    masked = view.grabWindow()
    if masked.isNull():
        raise RuntimeError("Offscreen masked SDDM capture failed")
    masked.save(str(output / "login-current-masked.png"))
    for suffix, boot_name in (("", "boot-unlock.png"), ("-masked", "boot-masked.png")):
        boot = output / boot_name
        if boot.is_file():
            comparison = Image.new("RGB", (1920, 572), "#07090e")
            for x, path, title in ((0, output / f"login-current{suffix}.png", "SDDM SOURCE"),
                                   (960, boot, "PLYMOUTH SOURCE")):
                with Image.open(path) as source:
                    comparison.paste(source.convert("RGB").resize((960, 540), Image.Resampling.LANCZOS), (x, 32))
                ImageDraw.Draw(comparison).text((x + 16, 10), title, fill="#53e3d2")
            comparison.save(output / f"login-boot{suffix}-compare.png")
    view.close()
