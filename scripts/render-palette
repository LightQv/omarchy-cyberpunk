#!/usr/bin/env python3
"""Render Cyberpunk shell roles from colors.toml without touching other themes."""

import argparse
import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent / "theme"
COLORS = ROOT / "colors.toml"
SHELL = ROOT / "shell.toml"
SDDM = ROOT.parent / "sddm-theme/palette.js"


def offset(color: str, delta: tuple[int, int, int]) -> str:
    rgb = [int(color[i : i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{min(255, max(0, value + change)):02x}" for value, change in zip(rgb, delta))


def replace_value(text: str, section: str | None, key: str, value: str) -> str:
    lines = text.splitlines(keepends=True)
    active = None
    found = False
    for index, line in enumerate(lines):
        match = re.fullmatch(r"\[([^]]+)\]\s*", line.strip())
        if match:
            active = match.group(1)
        elif active == section and re.match(rf"^{re.escape(key)}\s*=", line):
            lines[index] = re.sub(r'(?<=")#[0-9a-fA-F]{6}(?=")', value, line, count=1)
            found = True
            break
    if not found:
        raise ValueError(f"missing {section or 'root'}.{key}")
    return "".join(lines)


def render() -> dict[Path, str]:
    raw = COLORS.read_text()
    palette = tomllib.loads(raw)
    cyan = palette["cyan"]
    red = palette["red"]
    bright_cyan = offset(cyan, (85, 28, 32))
    bright_red = offset(red, (0, 52, 47))
    for key, value in (("bright_cyan", bright_cyan), ("bright_red", bright_red),
                       ("accent", red), ("selection", offset(cyan, (-61, -172, -154)))):
        raw = replace_value(raw, None, key, value)
    border = f'hyprland_active_border = "rgba({red[1:]}ff) rgba({offset(red, (-132, -20, -26))[1:]}ff) 45deg"'
    raw, count = re.subn(r'(?m)^hyprland_active_border = ".*"$', border, raw, count=1)
    if count != 1:
        raise ValueError("missing hyprland_active_border")
    palette.update(bright_cyan=bright_cyan, bright_red=bright_red, accent=red)

    shell = SHELL.read_text()
    roles = {
        "bar": {"background": "background", "text": "foreground", "active": "accent"},
        "hyprland": {"active-border": "accent", "active-border-foreground": "cyan"},
        "controls": {
            "normal-color": "foreground", "normal-border": "cyan", "hover-cursor-color": "cyan",
            "hover-cursor-border": "cyan", "focus-color": "cyan", "focus-border": "cyan",
            "selected-color": "accent", "selected-border": "accent",
        },
        "popups": {"background": "background", "text": "foreground", "border": "accent"},
        "tooltip": {"background": "background", "text": "foreground", "border": "cyan"},
        "notifications": {"background": "background", "text": "foreground",
                          "border": offset(cyan, (38, 28, 22)), "countdown": offset(red, (0, 19, 22))},
        "launcher": {"background": "background", "text": "foreground", "border": "cyan",
                     "scrim": "darker_background", "selected-background": "accent",
                     "selected-text": "bright_cyan", "selected-border": "accent"},
        "menu": {"background": "background", "text": "foreground",
                 "border": offset(cyan, (38, 28, 22)), "scrim": "darker_background",
                 "selected-background": "accent", "selected-text": offset(cyan, (98, 28, 34)),
                 "selected-border": offset(red, (0, 19, 22))},
        "polkit": {"background": "background", "text": "foreground", "text-error": "red",
                   "border": "cyan", "border-error": "red", "scrim": "darker_background", "accent": "red"},
        "lock": {"background": "background", "text": "foreground", "placeholder": "dark_foreground",
                 "text-error": "red", "border": "cyan", "border-active": "red",
                 "border-error": "red", "selection": "cyan"},
        "image-picker": {"scrim": "darker_background", "text": "foreground",
                         "selected-border": "red", "unselected-border": "cyan"},
    }
    for section, entries in roles.items():
        for key, source in entries.items():
            shell = replace_value(shell, section, key, palette.get(source, source))
    tomllib.loads(raw)
    tomllib.loads(shell)
    sddm_roles = {
        "background": palette["background"], "dark": palette["darker_background"],
        "burgundy": offset(red, (-204, -30, -40)), "panel": palette["background"],
        "red": red, "cyan": cyan, "text": palette["foreground"],
        "dim": palette["dark_foreground"],
    }
    sddm = "// Generated by scripts/render-palette from theme/colors.toml.\n"
    sddm += "".join(f'var {key} = "{value}"\n' for key, value in sddm_roles.items())
    return {COLORS: raw, SHELL: shell, SDDM: sddm}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--check", action="store_true")
    group.add_argument("--write", action="store_true")
    args = parser.parse_args()
    try:
        outputs = render()
        stale = [path for path, result in outputs.items() if path.read_text() != result]
        if args.check:
            if stale:
                print("Palette output stale: " + ", ".join(str(path) for path in stale), file=sys.stderr)
                return 1
        else:
            for path in stale:
                path.write_text(outputs[path])
    except (OSError, KeyError, ValueError, tomllib.TOMLDecodeError) as exc:
        print(f"Palette render failed: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
