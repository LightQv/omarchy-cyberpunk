#!/usr/bin/env bash
# Generate local-only, blurred artwork for the non-authenticating QML preview.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"
[[ $# == 0 || ( $# == 1 && ( $1 == --glitch || $1 == --record ) ) ]] || die "usage: scripts/preview-lock [--glitch|--record]"

source_image="$PROJECT/theme/backgrounds/01-lucy.png"
preview_dir="$PROJECT/lock-plugin/.preview"
preview_image="$preview_dir/blurred.png"
[[ -f $source_image ]] || die "local wallpaper missing: $source_image"
[[ -d $PROJECT/lock-plugin ]] || die "lock plugin directory missing"
[[ ! -e $preview_image && ! -L $preview_image ]] || die "preview image path is occupied: $preview_image"
umask 077
mkdir -p "$preview_dir"
trap 'rm -f -- "$preview_image"; rmdir -- "$preview_dir" 2>/dev/null || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
magick "$source_image" -resize '1280x720^' -gravity center -extent 1280x720 \
  -blur 0x6 -brightness-contrast '-1x-1' "$preview_image"
if [[ $# == 1 ]]; then
  /usr/lib/qt6/bin/qmlscene -S "${1#--}" "$PROJECT/lock-plugin/Preview.qml"
else
  /usr/lib/qt6/bin/qmlscene "$PROJECT/lock-plugin/Preview.qml"
fi
