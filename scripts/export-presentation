#!/usr/bin/env python3
"""Export a reviewed single-take recording without cuts or re-encoding."""

import hashlib
import json
from pathlib import Path
import subprocess

from PIL import Image, ImageDraw, ImageFont

ROOT = Path(__file__).resolve().parents[1]
WORK = ROOT / 'showcase/presentation'
MEDIA = ROOT / 'docs/media'


def main():
    result = json.loads((WORK / 'presentation-result.json').read_text())
    if not result.get('completed') or not result.get('continuous') or not result.get('authentication'):
        raise ValueError('Only a completed real-authentication take can be exported')
    subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', str(WORK / 'presentation.mp4'),
                    '-map', '0:v:0', '-c', 'copy', '-map_metadata', '-1', '-movflags', '+faststart',
                    str(MEDIA / 'presentation.mp4')], check=True)
    subprocess.run(['ffmpeg', '-v', 'error', '-y', '-ss', '2', '-i', str(MEDIA / 'presentation.mp4'),
                    '-frames:v', '1', str(WORK / 'poster.png')], check=True)
    with Image.open(WORK / 'poster.png') as frame:
        image = frame.convert('RGBA')
    overlay = Image.new('RGBA', image.size)
    drawing = ImageDraw.Draw(overlay)
    drawing.rounded_rectangle((570, 405, 1350, 680), radius=18, fill=(7,9,14,220), outline='#53e3d2', width=3)
    drawing.polygon(((870,440),(870,540),(960,490)), fill='#53e3d2')
    font_path = subprocess.check_output(['fc-match', '-f', '%{file}', 'sans-serif'], text=True)
    font = ImageFont.truetype(font_path, 34)
    drawing.text((960,575), 'WATCH THE PRESENTATION', anchor='mm', font=font, fill='#e5f1ee')
    drawing.text((960,635), '73 seconds · one continuous take', anchor='mm',
                 font=ImageFont.truetype(font_path,24), fill='#53e3d2')
    Image.alpha_composite(image, overlay).convert('RGB').save(MEDIA / 'presentation-poster.png', optimize=True)
    metadata = json.loads(subprocess.check_output(['ffprobe', '-v', 'error', '-show_entries',
        'stream=width,height,avg_frame_rate:format=duration', '-of', 'json', str(MEDIA / 'presentation.mp4')]))
    path = MEDIA / 'manifest.json'
    manifest = json.loads(path.read_text())
    manifest['presentation'] = {
        'kind': 'continuous live desktop capture, cursor excluded; real sudo retry/success and Polkit success',
        'version': 'v0.1.4', 'cuts': 0, 'audio': False,
        'duration': float(metadata['format']['duration']), 'stages': result['stages'],
        'notes': 'Clean demonstration terminals; private-bus sample notifications and sample OSD payloads. Actual audio unchanged. Passwords entered by user into masked dialogs.',
        'inputs': {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest()
                   for name in ('scripts/presentation.py', 'scripts/export-presentation')},
    }
    for name in ('presentation.mp4', 'presentation-poster.png'):
        manifest['files'][name] = hashlib.sha256((MEDIA / name).read_bytes()).hexdigest()
    path.write_text(json.dumps(manifest, indent=2) + '\n')
    print('Exported the reviewed continuous take and linked poster.')


if __name__ == '__main__':
    main()
