#!/usr/bin/env python3
"""Export a reviewed single-take recording without cuts or re-encoding."""

import argparse
import hashlib
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[1]
WORK = ROOT / 'showcase/presentation'
MEDIA = ROOT / 'docs/media'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--take', default='', help='Filename suffix of the reviewed real take')
    parser.add_argument('--attachment-url', help='Public GitHub user-attachment URL for inline playback')
    args = parser.parse_args()
    if args.take and not args.take.isalnum():
        raise ValueError('Take suffix must be alphanumeric')
    if args.attachment_url and not args.attachment_url.startswith('https://github.com/user-attachments/assets/'):
        raise ValueError('Use the stable public GitHub user-attachment URL')
    name = 'presentation' + ('-' + args.take if args.take else '')
    result = json.loads((WORK / (name + '-result.json')).read_text())
    if not result.get('completed') or not result.get('continuous') or not result.get('authentication'):
        raise ValueError('Only a completed real-authentication take can be exported')
    subprocess.run(['ffmpeg', '-v', 'error', '-y', '-i', str(WORK / (name + '.mp4')),
                    '-map', '0:v:0', '-c', 'copy', '-map_metadata', '-1', '-movflags', '+faststart',
                    str(MEDIA / 'presentation.mp4')], check=True)
    metadata = json.loads(subprocess.check_output(['ffprobe', '-v', 'error', '-show_entries',
        'stream=width,height,avg_frame_rate:format=duration', '-of', 'json', str(MEDIA / 'presentation.mp4')]))
    path = MEDIA / 'manifest.json'
    manifest = json.loads(path.read_text())
    manifest['presentation'] = {
        'kind': 'continuous live desktop capture, cursor excluded; real Polkit retry/success' if result['authentication'] == 'polkit-retry'
                else 'continuous live desktop capture, cursor excluded; real sudo retry/success and Polkit success',
        'version': 'v0.1.4', 'cuts': 0, 'audio': False,
        'duration': float(metadata['format']['duration']), 'stages': result['stages'],
        'resolution': [metadata['streams'][0]['width'], metadata['streams'][0]['height']],
        'notes': 'Clean demonstration terminals; private-bus sample notifications and sample OSD payloads. Actual audio unchanged. Passwords entered by user into masked dialogs.',
        'inputs': {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest()
                   for name in ('scripts/presentation.py', 'scripts/presentation-terminal.py', 'scripts/export-presentation')},
    }
    if args.attachment_url:
        manifest['presentation']['attachmentURL'] = args.attachment_url
    manifest['files'].pop('presentation-poster.png', None)
    for name in ('presentation.mp4',):
        manifest['files'][name] = hashlib.sha256((MEDIA / name).read_bytes()).hexdigest()
    path.write_text(json.dumps(manifest, indent=2) + '\n')
    print('Exported the reviewed continuous take for inline presentation.')


if __name__ == '__main__':
    main()
