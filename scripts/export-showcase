#!/usr/bin/env python3
"""Publish reviewed showcase renders as compact stills, GIFs and full-quality clips."""

import hashlib
import json
from pathlib import Path
import shutil
import subprocess

from PIL import Image

ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "docs/media"
DESKTOP = ROOT / "showcase"
AUTH = ROOT / "preview"


def image(source, target, crop=None, maximum=1600):
    with Image.open(source) as original:
        rendered = original.convert("RGB")
        if crop: rendered = rendered.crop(crop)
        rendered.thumbnail((maximum, maximum), Image.Resampling.LANCZOS)
        rendered.save(OUTPUT / target, optimize=True)


def gif(source, target, crop=None):
    filters = (f"crop={crop}," if crop else "") + "fps=12,scale=800:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=128[p];[b][p]paletteuse=dither=bayer:bayer_scale=4"
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(source), "-vf", filters,
                    "-loop", "0", str(OUTPUT / target)], check=True)


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    image(DESKTOP / "hero.png", "hero.png")
    for name, crop in {"menu": (70, 250, 700, 850), "apps": (70, 250, 700, 850),
                       "keybindings": (1200, 260, 1870, 850), "notifications": (550, 0, 1370, 510),
                       "volume": (480, 580, 1440, 1080), "mute": (480, 580, 1440, 1080)}.items():
        image(DESKTOP / f"{name}.png", f"{name}.png", crop)
    image(DESKTOP / "wallpapers.png", "wallpapers.png")
    for name in ("lock", "sudo", "polkit"):
        image(AUTH / f"{name}.png", f"{name}.png")
        image(AUTH / f"{name}.png", f"{name}-detail.png", (560, 340, 1360, 880))
        shutil.copyfile(AUTH / f"{name}.mp4", OUTPUT / f"{name}.mp4")
    shutil.copyfile(DESKTOP / "menu.mp4", OUTPUT / "menu.mp4")
    gif(DESKTOP / "menu.mp4", "menu.gif", "720:660:50:230")
    gif(AUTH / "polkit.mp4", "auth.gif")
    manifest = {
        "version": 1,
        "desktop": json.loads((DESKTOP / "manifest.json").read_text()),
        "auth": json.loads((AUTH / "manifest.json").read_text()),
        "files": {path.name: hashlib.sha256(path.read_bytes()).hexdigest()
                  for path in sorted(OUTPUT.iterdir()) if path.suffix in (".png", ".gif", ".mp4")},
    }
    previous = OUTPUT / "manifest.json"
    if previous.exists():
        live = json.loads(previous.read_text()).get("liveDesktop")
        if live and (OUTPUT / "desktop.png").exists():
            manifest["liveDesktop"] = live
        presentation = json.loads(previous.read_text()).get('presentation')
        if presentation and (OUTPUT / 'presentation.mp4').exists():
            manifest['presentation'] = presentation
    (OUTPUT / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    print(f"Published {len(manifest['files'])} showcase assets to docs/media.")


if __name__ == "__main__":
    main()
