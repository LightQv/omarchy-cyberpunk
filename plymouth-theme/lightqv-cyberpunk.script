# The callback and monotonic fake-to-real boot progression follow Omarchy's
# packaged Plymouth script. This is a separately owned theme, not a LUKS UI.
Window.SetBackgroundTopColor(0.12, 0.035, 0.07);
Window.SetBackgroundBottomColor(0.035, 0.04, 0.06);
frame.original = Image("frame.png");
frame.image = frame.original.Scale(Window.GetWidth(), Window.GetHeight());
frame.sprite = Sprite(frame.image);
frame.sprite.SetPosition(0, 0, 0);

logo.original = Image("logo.png");
logo.unit_height = logo.original.GetHeight() * 840 / logo.original.GetWidth();
prompt.scale = 0.75;
width_scale = 0.75 * Window.GetWidth() / 1920;
height_scale = 0.75 * Window.GetHeight() / 1080;
if (width_scale < prompt.scale) prompt.scale = width_scale;
if (height_scale < prompt.scale) prompt.scale = height_scale;
window_scale = (Window.GetWidth() - 50) / 451;
if (window_scale < prompt.scale) prompt.scale = window_scale;
prompt.x = (Window.GetWidth() - 451 * prompt.scale) / 2;
prompt.offset = Window.GetHeight() * 0.105;
if (prompt.offset > 112) prompt.offset = 112;
prompt.y = Window.GetHeight() / 2 + prompt.offset * prompt.scale - (138 + 54 / 2) * prompt.scale;
prompt.top = prompt.y - (8 + logo.unit_height) * prompt.scale;

entry.original = Image("entry.png");
entry.scale = prompt.scale;
entry.width = 381 * entry.scale;
entry.image = entry.original.Scale(entry.width, entry.original.GetHeight() * entry.scale / 2);
entry.x = prompt.x + (451 - 381) / 2 * entry.scale;
entry.y = prompt.y + 138 * entry.scale;

logo.width = 840 * entry.scale;
logo.image = logo.original.Scale(logo.width, logo.original.GetHeight() * logo.width / logo.original.GetWidth());
logo.frames = [Image("logo-fault-0.png").Scale(logo.width, logo.image.GetHeight()),
  Image("logo-fault-1.png").Scale(logo.width, logo.image.GetHeight()),
  Image("logo-fault-2.png").Scale(logo.width, logo.image.GetHeight()),
  Image("logo-fault-3.png").Scale(logo.width, logo.image.GetHeight()),
  Image("logo-fault-4.png").Scale(logo.width, logo.image.GetHeight()),
  Image("logo-fault-5.png").Scale(logo.width, logo.image.GetHeight()),
  Image("logo-fault-6.png").Scale(logo.width, logo.image.GetHeight())];
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition((Window.GetWidth() - logo.width) / 2, prompt.top, 1);
logo.sprite.SetImage(logo.frames[0]);
global.logo_tick = 0;
global.logo_step = 0;

entry.sprite = Sprite(entry.image);
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);
scanner.original = Image("scanner.png");
scanner.image = scanner.original.Scale(451 * entry.scale, 138 * entry.scale);
scanner.sprite = Sprite(scanner.image);
scanner.sprite.SetPosition(prompt.x, prompt.y, 10001);
scanner.sprite.SetOpacity(0);
placeholder.original = Image("placeholder.png");
placeholder.image = placeholder.original.Scale(entry.width, entry.image.GetHeight());
placeholder.sprite = Sprite(placeholder.image);
placeholder.sprite.SetPosition(entry.x, entry.y, 10002);
placeholder.sprite.SetOpacity(0);

action.original = Image("action.png");
action.image = action.original.Scale(entry.width, action.original.GetHeight() * entry.scale / 2);
action.sprite = Sprite(action.image);
action.sprite.SetPosition(entry.x, prompt.y + 208 * entry.scale, 10001);
action.sprite.SetOpacity(0);
# Plymouth is keyboard-only: this graphic is a label and Enter hint, not a control.
hint.original = Image("hint.png");
hint.image = hint.original.Scale(entry.width, 18 * entry.scale);
hint.sprite = Sprite(hint.image);
hint.sprite.SetPosition(entry.x, prompt.y + 268 * entry.scale, 10001);
hint.sprite.SetOpacity(0);

bullet.original = Image("bullet.png");
bullet.sprites = [];
caret.original = Image("caret.png");
caret.image = caret.original.Scale(2 * entry.scale, 25 * entry.scale);
caret.sprite = Sprite(caret.image);
caret.sprite.SetOpacity(0);

progress_box.original = Image("progress_box.png");
progress_box.image = progress_box.original.Scale(entry.width, 18 * entry.scale);
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetPosition(entry.x, prompt.y + (138 + (54 - 18) / 2) * entry.scale, 1);
progress_box.sprite.SetOpacity(0);
progress_bar.original = Image("progress_bar.png").Scale(entry.width, 18 * entry.scale);
progress_bar.sprite = Sprite();
progress_bar.sprite.SetPosition(entry.x, prompt.y + (138 + (54 - 18) / 2) * entry.scale, 2);
progress_bar.sprite.SetOpacity(0);

global.animation_frame = 0;
global.fake_progress = 0.0;
global.fake_progress_active = 0;
global.fake_progress_start_time = 0.0;
global.password_shown = 0;
global.max_progress = 0.0;

fun hide_password_dialog() {
  entry.sprite.SetOpacity(0);
  scanner.sprite.SetOpacity(0);
  placeholder.sprite.SetOpacity(0);
  action.sprite.SetOpacity(0);
  hint.sprite.SetOpacity(0);
  caret.sprite.SetOpacity(0);
  for (index = 0; bullet.sprites[index]; index++) bullet.sprites[index].SetOpacity(0);
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;
  global.fake_progress_active = 0;
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(1);
  scanner.sprite.SetOpacity(1);
  placeholder.sprite.SetOpacity(1);
  action.sprite.SetOpacity(1);
  hint.sprite.SetOpacity(1);
  for (index = 0; bullet.sprites[index]; index++) bullet.sprites[index].SetOpacity(0);
  count = bullets;
  if (count > 21) count = 21;
  if (count > 0) placeholder.sprite.SetOpacity(0);
  bullet.step = 20;
  if (count > 0 && count * bullet.step > 301) bullet.step = 301 / count;
  bullet.glyph = 14;
  if (bullet.step * 0.76 < bullet.glyph) bullet.glyph = bullet.step * 0.76;
  bullet.image = bullet.original.Scale(16 * entry.scale * bullet.glyph / 14, 30 * entry.scale);
  for (index = 0; index < count; index++) {
    if (!bullet.sprites[index]) bullet.sprites[index] = Sprite();
    bullet.sprites[index].SetImage(bullet.image);
    bullet.sprites[index].SetPosition(entry.x + (56 + index * bullet.step) * entry.scale,
      entry.y + (54 - 30) / 2 * entry.scale, 10002);
    bullet.sprites[index].SetOpacity(1);
  }
  if (count > 0) {
    caret.sprite.SetPosition(entry.x + (56 + count * bullet.step + 2) * entry.scale,
      entry.y + (54 - 25) / 2 * entry.scale, 10002);
    caret.sprite.SetOpacity(1);
  } else {
    caret.sprite.SetOpacity(0);
  }
}

fun update_progress_bar(progress) {
  if (progress > global.max_progress) {
    global.max_progress = progress;
    width = Math.Int(progress_bar.original.GetWidth() * progress);
    if (width < 1) width = 1;
    progress_bar.sprite.SetImage(progress_bar.original.Scale(width, progress_bar.original.GetHeight()));
  }
}

fun display_normal_callback() {
  hide_password_dialog();
  mode = Plymouth.GetMode();
  if ((mode == "boot" || mode == "resume") && global.password_shown == 1) {
    progress_box.sprite.SetOpacity(1);
    progress_bar.sprite.SetOpacity(1);
    global.animation_frame = 0;
    global.fake_progress = 0.0;
    global.max_progress = 0.0;
    global.fake_progress_start_time = 0.0;
    global.fake_progress_active = 1;
  }
}

fun refresh_callback() {
  # One entrance sequence only; password retries and boot progress never replay it.
  if (global.logo_tick < 24) {
    global.logo_tick++;
    next_step = 7;
    if (global.logo_tick < 4) next_step = 0;
    else if (global.logo_tick < 6) next_step = 1;
    else if (global.logo_tick < 10) next_step = 2;
    else if (global.logo_tick < 12) next_step = 3;
    else if (global.logo_tick < 16) next_step = 4;
    else if (global.logo_tick < 19) next_step = 5;
    else if (global.logo_tick < 24) next_step = 6;
    if (next_step != global.logo_step) {
      global.logo_step = next_step;
      if (next_step == 7) logo.sprite.SetImage(logo.image);
      else logo.sprite.SetImage(logo.frames[next_step]);
    }
  }
  if (global.fake_progress_active == 1) {
    global.animation_frame++;
    ratio = (global.animation_frame / 50.0) / 15.0;
    if (ratio > 1.0) ratio = 1.0;
    global.fake_progress = (1 - ((1 - ratio) * (1 - ratio))) * 0.7;
    update_progress_bar(global.fake_progress);
  }
}

fun progress_callback(duration, progress) {
  if (global.fake_progress_start_time == 0.0) global.fake_progress_start_time = duration;
  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    global.fake_progress_active = 0;
    update_progress_bar(progress);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetBootProgressFunction(progress_callback);

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);
fun display_message_callback(text) {
  message_sprite.SetImage(Image.Text(text, 1, 1, 1));
  message_sprite.SetOpacity(1);
}
fun hide_message_callback(text) { message_sprite.SetOpacity(0); }
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
